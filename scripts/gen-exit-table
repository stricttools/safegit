#!/usr/bin/env bash
# Regenerate the exit-code reference table in docs/commands-guide.md from
# internal/exitcode's registry. Run it after adding or changing a code.
#
# The matching freshness check lives in exit_table_test.go, so a registry
# change that was not regenerated fails `go test .` rather than shipping a
# stale table.
set -euo pipefail
cd "$(dirname "$0")/.."
exec go run scripts/gen-exit-table.go "$@"
