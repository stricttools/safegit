#!/usr/bin/env bash
# Capture the campaign test baseline as a deterministic artifact.
#
# The artifact records whatever the suite reports -- passes, failures and skips
# alike -- and says nothing about which of those is expected. Refactors that are
# supposed to be behavior-preserving are checked by regenerating it and diffing
# it against the committed one: a diff is a behavior change to account for,
# whatever the suite's overall verdict is.
#
# Usage:
#   scripts/test-baseline [output-path]      # write the artifact (default: stdout)
#   scripts/test-baseline --check <path>     # regenerate and diff against <path>
#
# Output format: a few '#' header lines (commands used, git HEAD at capture
# time), then one line per test, sorted, "<RESULT> <package> <testname>" with
# RESULT in {PASS,FAIL,SKIP}. Subtests appear exactly as go test reports them.
#
# -short is always passed, and it no longer has anything to do with the stress
# scenarios: those are opt-in behind the test binary's --stress flag and are
# excluded here simply because this script does not pass it. What -short still
# does is keep the artifact deterministic. TWO tests key on testing.Short():
# internal/hooks' wall-clock hook-timeout test, which it SKIPS because the
# result depends on timing rather than on the code under test, and
# internal/git's index-reconcile property test, which it SHORTENS from 200
# generated cases to 40 -- the same one test line either way, over fewer cases.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# jq distills `go test -json` below. Without it the distill pipeline dies with
# a "jq: command not found" buried behind minutes of test output, so name the
# missing dependency up front and before anything expensive runs.
if ! command -v jq >/dev/null 2>&1; then
	echo "test-baseline: jq is required but was not found on PATH; install jq and re-run" >&2
	exit 1
fi

check_mode=0
out=""
case "${1:-}" in
	--check)
		check_mode=1
		out="${2:?--check requires a path to diff against}"
		;;
	"") out="" ;;
	*) out="$1" ;;
esac

integration_pkg="./internal/test/"
mapfile -t unit_pkgs < <(go list ./... | grep -v '/internal/test$')

# Recorded verbatim in the artifact header: the argv actually run, not a
# description of it, so a later reader can re-run exactly this.
integration_cmd="go test $integration_pkg -short -count=1 -json"
unit_cmd="go test ${unit_pkgs[*]} -short -count=1 -json"

# Distill go test -json into "<RESULT> <package> <test>" lines.
distill() {
	jq -r '
		select(.Test != null)
		| select(.Action == "pass" or .Action == "fail" or .Action == "skip")
		| "\(.Action | ascii_upcase) \(.Package) \(.Test)"
	'
}

# Build failures produce package-level events with no per-test events at all,
# which would silently shrink the artifact. Refuse instead.
#
# The match is a case pattern rather than a pipeline into grep: under
# `set -o pipefail`, grep -q exits at the first match, the writer at the head of
# the pipe dies of EPIPE, and the pipeline's status becomes 141 -- so the guard
# would not fire on exactly the large outputs it exists for. No writer, no
# SIGPIPE.
guard_build_failures() {
	case "$1" in
	*"[build failed]"*)
		echo "test-baseline: build failure in test output; refusing to write a baseline" >&2
		exit 1
		;;
	esac
}

# A nonzero exit is not an error here: the artifact is the pass/fail set itself,
# so a failing test is content to record rather than a reason to stop.
integration_json="$(go test "$integration_pkg" -short -count=1 -json || true)"
unit_json="$(go test "${unit_pkgs[@]}" -short -count=1 -json || true)"

guard_build_failures "$integration_json"
guard_build_failures "$unit_json"

baseline="$(
	echo "# safegit campaign test baseline"
	echo "# integration: $integration_cmd"
	echo "# unit: $unit_cmd"
	echo "# git HEAD: $(git rev-parse HEAD)"
	printf '%s\n%s\n' "$integration_json" "$unit_json" | distill | LC_ALL=C sort
)"

if [ "$check_mode" = 1 ]; then
	# Compare test lines only: the header records capture-time state (HEAD),
	# which legitimately differs on every later run.
	diff <(grep -v '^#' "$out") <(printf '%s\n' "$baseline" | grep -v '^#')
	echo "test-baseline: pass/fail set identical to $out"
elif [ -n "$out" ]; then
	printf '%s\n' "$baseline" >"$out"
	echo "test-baseline: wrote $out" >&2
else
	printf '%s\n' "$baseline"
fi
