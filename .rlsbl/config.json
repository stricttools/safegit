{
  "targets": [
    "go",
    "docker"
  ],
  "pipelines": {
    "go": {
      "type": "go",
      "target": "go",
      "local": true,
      "install_paths": [
        "."
      ],
      "artifact": "binary"
    },
    "docker": {
      "type": "docker",
      "target": "docker",
      "local": false
    }
  },
  "publish_mode": "ci",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": []
  },
  "hooks": {
    "pre_release": [
      "go vet ./...",
      "go build -o /dev/null .",
      "go test ./... -race -short -count=1"
    ]
  },
  "coverage_unit": "commit"
}
